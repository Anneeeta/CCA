# Official DeepSeek generation and optional Search (separate key if supplied).
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_API_KEY=

# Optional model providers; select the corresponding model explicitly in YAML.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional custom OpenAI-compatible model route.
CCA_API_KEY=
CCA_BASE_URL=https://api.deepseek.com/v1

# Optional Tavily search. A JSON key list takes priority over the single key.
TAVILY_API_KEY=
TAVILY_API_KEYS=[]
TAVILY_KEY_CALL_LIMIT=950
TAVILY_USAGE_PATH=data/tavily_key_usage.sqlite3
